[Unit]
Description=dstack gateway service
After=network.target

[Service]
ExecStart=/bin/sh {working_dir}/start.sh
WorkingDirectory={working_dir}
User=ubuntu
Group=ubuntu
Restart=always
RestartSec=5
# Above uvicorn's graceful shutdown timeout in start.sh, so that the app can shut down after it
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=default.target
